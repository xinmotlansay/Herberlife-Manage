{
  "name": "herbalife-manager-desktop",
  "version": "1.0.0",
  "description": "Herbalife Warehouse & Sales Management Desktop App",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev:backend": "node --watch backend/src/app.js",
    "dev:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "npm run build:frontend && electron-builder",
    "pack": "electron-builder --dir",
    "dist": "npm run build:frontend && electron-builder --mac"
  },
  "build": {
    "appId": "com.herbalife.manager",
    "productName": "Herbalife Manager",
    "copyright": "Copyright © 2026 Herbalife Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "backend/**/*",
      "frontend/dist/**/*",
      "!backend/backups/*.sqlite",
      "!backend/data/*.sqlite"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "electron/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "electron/icon.ico"
    },
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**"
    ]
  },
  "dependencies": {
    "@google-cloud/vision": "^4.3.2",
    "better-sqlite3": "^11.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "electron": "^34.5.8",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.5"
  }
}
